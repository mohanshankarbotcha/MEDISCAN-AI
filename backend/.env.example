# Midiscanai Backend Environment Variables
# Node.js only — no Python variables

PORT=5000
NODE_ENV=development

# Anthropic Claude AI — JavaScript SDK reads this automatically
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database — Prisma ORM (JavaScript) connects using this URL
DATABASE_URL=file:./dev.db

# JWT Authentication
SECRET_KEY=generate_a_random_64_character_string_here
JWT_EXPIRES_IN=24h

# AES Encryption
ENCRYPTION_KEY=generate_a_random_64_character_hex_string_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Email (Nodemailer — Node.js package)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_KB=40
MIN_FILE_SIZE_KB=10
